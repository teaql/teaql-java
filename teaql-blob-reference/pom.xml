<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>io.teaql</groupId><artifactId>teaql-java-parent</artifactId><version>1.555-RELEASE</version></parent>
    <artifactId>teaql-blob-reference</artifactId>
    <description>Optional Blob reference services and trusted policy resolution</description>
    <properties><argLine></argLine></properties>
    <dependencies>
        <dependency><groupId>io.teaql</groupId><artifactId>teaql-core</artifactId></dependency>
        <dependency><groupId>io.teaql</groupId><artifactId>teaql-data-service-sql</artifactId></dependency>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
        <dependency><groupId>junit</groupId><artifactId>junit</artifactId><scope>test</scope></dependency>
        <dependency><groupId>io.teaql</groupId><artifactId>teaql-provider-jdbc</artifactId><scope>test</scope></dependency>
        <dependency><groupId>io.teaql</groupId><artifactId>teaql-dynamic-fields-jdbc</artifactId><scope>test</scope></dependency>
        <dependency><groupId>io.teaql</groupId><artifactId>teaql-runtime</artifactId><scope>test</scope></dependency>
        <dependency><groupId>io.teaql</groupId><artifactId>teaql-blob-store-file</artifactId><scope>test</scope></dependency>
        <dependency><groupId>io.teaql</groupId><artifactId>teaql-blob-store-s3</artifactId><scope>test</scope></dependency>
        <dependency><groupId>io.teaql</groupId><artifactId>teaql-blob-content-tika</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><version>42.7.3</version><scope>test</scope></dependency>
    </dependencies>
    <build><plugins><plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration><argLine>@{argLine} --add-reads io.teaql.blob.reference=io.teaql.runtime --add-reads io.teaql.blob.reference=java.sql</argLine></configuration>
    </plugin></plugins></build>
</project>
