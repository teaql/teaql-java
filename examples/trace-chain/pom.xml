    <dependency><groupId>io.teaql</groupId><artifactId>teaql-provider-jdbc</artifactId></dependency>
    <dependency><groupId>junit</groupId><artifactId>junit</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build><plugins><plugin>
    <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version>
    <configuration><systemPropertyVariables><teaql.trace.database>${teaql.trace.database}</teaql.trace.database></systemPropertyVariables></configuration>
  </plugin></plugins></build>
